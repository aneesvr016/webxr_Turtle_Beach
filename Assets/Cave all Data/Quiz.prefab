MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3658962540518283342}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0e9ba93ff30519c44b5aafe616c52142, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  questions:
  - question: 'What is Barry the Basalt Golem made from? '
    optionA: A) Sand that got stuck together
    optionB: B) Lava that cooled down quickly
    optionC: C) Limestone that got cooked underground
    optionD: D) Magma that cooled slowly underground
    correctAnswer: B
  - question: 'What colour is Gracie the Granite Golem usually? '
    optionA: A) Dark black or grey
    optionB: B) Light colours like pink, grey, or white
    optionC: C) Always pure white
    optionD: D) Red or orange
    correctAnswer: B
  - question: 'What type of rock is Leroy the Limestone Golem? '
    optionA: A) Igneous rock
    optionB: B) Metamorphic rock
    optionC: C) Sedimentary rock
    optionD: D) Mineral
    correctAnswer: C
  - question: 'What was Sally the Sandstone Golem made from? '
    optionA: A) Melted lava
    optionB: B) Sea creature shells
    optionC: C) Changed limestone
    optionD: D) Layers of sand stuck together
    correctAnswer: D
  - question: 'What happened to Marvin the Marble Golem to make him change from limestone? '
    optionA: A) He was squeezed and heated deep underground
    optionB: B) He was melted in a volcano
    optionC: C) He was washed by ocean waves
    optionD: D) He was frozen in ice
    correctAnswer: A
  - question: 'What makes Quinn the Quartz Golem different from all the other '
    optionA: A) She is the hardest rock
    optionB: B) She is a mineral, not a rock
    optionC: C) She is made from lava
    optionD: D) She is made from sand
    correctAnswer: B
  - question: Why has Clayton the Clay Soil Golem collapsed into a pile?
    optionA: A) He melted in the sun
    optionB: B) He got too cold
    optionC: C) He is made of tiny particles that get sticky and heavy when wet
    optionD: D) He is made of sand that falls apart
    correctAnswer: C
  - question: 'What special trick does Leroy the Limestone Golem have? '
    optionA: A) He sparkles like a diamond
    optionB: B) He can float on water
    optionC: C) He fizzes and bubbles when you put vinegar on him
    optionD: D) He glows in the dark
    correctAnswer: C
  - question: 'Where was Gracie the Granite Golem formed? '
    optionA: A) At the bottom of the ocean
    optionB: B) On top of a volcano
    optionC: C) Deep underground where magma cooled slowly
    optionD: D) In a desert
    correctAnswer: C
  - question: 'What can you see on Sally the Sandstone Golem''s surface? '
    optionA: A) Tiny shell fossils
    optionB: B) Individual grains of sand
    optionC: C) Smooth, glassy crystals
    optionD: D) Coloured veins and swirls
    correctAnswer: B
  - question: Which type of rock is Barry the Basalt Golem?
    optionA: A) Sedimentary rock
    optionB: B) Metamorphic rock
    optionC: C) Mineral
    optionD: D) Igneous rock
    correctAnswer: D
  - question: 'What does the word "metamorphic" mean? '
    optionA: A) Made from fire
    optionB: B) Made from layers
    optionC: C) Changed rock
    optionD: D) Very old rock
    correctAnswer: C
  - question: 'How hard is Quinn the Quartz Golem compared to the other golems? '
    optionA: A) She is the softest
    optionB: B) She is about the same hardness
    optionC: C) She is harder than all the rock golems
    optionD: D) She is softer than clay
    correctAnswer: C
  - question: 'Which soil type is considered the "perfect" soil for growing plants? '
    optionA: A) Clay soil
    optionB: B) Sandy soil
    optionC: C) Chalky soil
    optionD: D) Loamy soil
    correctAnswer: D
  - question: "What are the three main minerals you can see in Gracie the Granite
      Golem? \r"
    optionA: A) Salt, pepper, and sugar
    optionB: B) Quartz, feldspar, and mica
    optionC: C) Sand, shells, and fossils
    optionD: D) Iron, copper, and gold
    correctAnswer: B
  - question: " What colour are the \"holes\" or bubbles in Barry the Basalt Golem
      from? \r"
    optionA: A) Water trapped in the rock
    optionB: B) Air pockets from animals
    optionC: C) Gas bubbles trapped when the lava cooled
    optionD: D) Sand that got stuck inside
    correctAnswer: C
  - question: 'Which soil drains water the FASTEST? '
    optionA: A) Clay soil
    optionB: B) Sandy soil
    optionC: C) Peaty soil
    optionD: D) Silty soil
    correctAnswer: B
  - question: 'What was Marvin the Marble Golem before he transformed? '
    optionA: A) Granite
    optionB: B) Basalt
    optionC: C) Sandstone
    optionD: D) Limestone
    correctAnswer: D
  - question: 'Why does Sally the Sandstone Golem have different colours (red, orange,
      yellow, brown)? '
    optionA: A) She was painted those colours
    optionB: B) Different minerals like iron were mixed in with the sand
    optionC: C) She gets sunburned
    optionD: D) Fossils give her those colours
    correctAnswer: B
  - question: 'What happens to rocks over millions of years to create soil? '
    optionA: 'A) They melt into liquid '
    optionB: B) They turn into plants
    optionC: C) Weathering breaks them down into tiny particles
    optionD: D) They sink underground
    correctAnswer: C
