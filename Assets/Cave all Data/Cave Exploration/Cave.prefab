  - component: {fileID: 2467276913000400503}
  - component: {fileID: 6475245448296321767}
  m_Layer: 0
  m_Name: Marble Golem(Marvin)
  m_TagString: Untagged
  m_Icon: {fileID: 0}
  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
--- !u!4 &2467276913000400503
Transform:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2988461138595263597}
  serializedVersion: 2
  m_LocalRotation: {x: -0, y: 0.6173806, z: -0, w: 0.78666466}
