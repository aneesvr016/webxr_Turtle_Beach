--- !u!4 &9002069409231664913
Transform:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6654974095370080414}
  serializedVersion: 2
  m_LocalRotation: {x: -0, y: 0.9632464, z: -0, w: 0.2686193}
