  m_Name: Granite Golem(Gracie)
  m_TagString: Untagged
  m_Icon: {fileID: 0}
  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
--- !u!4 &7653327771521375122
Transform:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4381550666326819795}
  serializedVersion: 2
  m_LocalRotation: {x: -0, y: 0.030345336, z: -0, w: 0.9995395}
  m_LocalPosition: {x: -16.695282, y: 9.972065, z: -6.4134927}
